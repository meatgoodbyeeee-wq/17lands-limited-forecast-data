+    // L4 research helper: does this sacrifice-self protection ability save other creatures worth more than the source?
+    private static boolean l4SacSavesMoreValuable(final Player ai, final Card source, final SpellAbility sa) {
+        if (sa == null) {
+            return false;
+        }
+        final ApiType api = sa.getApi();
+        if (api != ApiType.Pump && api != ApiType.PumpAll && api != ApiType.Protection && api != ApiType.ProtectionAll) {
+            return false;
+        }
+        final boolean all = api == ApiType.PumpAll || api == ApiType.ProtectionAll;
+        final String kw = sa.getParamOrDefault("KW", "");
+        final boolean indestructible = kw.contains("Indestructible");
+        final boolean protective = api == ApiType.Protection || api == ApiType.ProtectionAll || indestructible
+                || kw.contains("Hexproof") || kw.contains("Shroud") || kw.contains("Protection");
+        if (!protective) {
+            return false;
+        }
+        final forge.game.Game game = ai.getGame();
+        final java.util.Set<Card> saved = new java.util.LinkedHashSet<>();
+        if (!game.getStack().isEmpty()) {
+            for (final GameObject o : ComputerUtil.predictThreatenedObjects(ai, sa, true)) {
+                if (o instanceof Card c && c.getController().equals(ai) && c.isCreature() && !c.equals(source) && (all || sa.canTarget(c))) {
+                    saved.add(c);
+                }
+            }
+        }
+        final Combat combat = game.getCombat();
+        if (indestructible && combat != null && game.getPhaseHandler().is(PhaseType.COMBAT_DECLARE_BLOCKERS)) {
+            for (final Card c : ai.getCreaturesInPlay()) {
+                if (!c.equals(source) && (combat.isAttacking(c) || combat.isBlocking(c)) && (all || sa.canTarget(c))
+                        && ComputerUtilCombat.combatantWouldBeDestroyed(ai, c, combat)) {
+                    saved.add(c);
+                }
+            }
+        }
+        if (saved.isEmpty()) {
+            return false;
+        }
+        int value = 0;
+        for (final Card c : saved) {
+            value = all ? value + ComputerUtilCard.evaluateCreature(c) : Math.max(value, ComputerUtilCard.evaluateCreature(c));
+        }
+        return value > ComputerUtilCard.evaluateCreature(source);
+    }
 }
