+
+    // L4 research helper: the ETB trigger whose effect is a targeted Pump/Protection/PutCounter on something you control.
+    private static forge.game.trigger.Trigger l4ProtectiveEtb(final Card card) {
+        for (final forge.game.trigger.Trigger tr : card.getTriggers()) {
+            if (tr.getMode() != forge.game.trigger.TriggerType.ChangesZone) {
+                continue;
+            }
+            if (!"Battlefield".equals(tr.getParam("Destination")) || !tr.hasParam("ValidCard") || !tr.getParam("ValidCard").contains("Self")) {
+                continue;
+            }
+            final SpellAbility ex = tr.ensureAbility();
+            if (ex == null || !ex.usesTargeting() || ex.isCurse()) {
+                continue;
+            }
+            final ApiType api = ex.getApi();
+            if (api != ApiType.Pump && api != ApiType.Protection && api != ApiType.PutCounter) {
+                continue;
+            }
+            if (!ex.getParamOrDefault("ValidTgts", "").contains("YouCtrl")) {
+                continue;
+            }
+            return tr;
+        }
+        return null;
+    }
+
+    // L4 research helper: would the ETB effect be worth using right now?
+    private static boolean l4EtbWorthNow(final Card card, final Player ai) {
+        final forge.game.trigger.Trigger tr = l4ProtectiveEtb(card);
+        if (tr == null) {
+            return false;
+        }
+        try {
+            final SpellAbility ex = tr.ensureAbility().copy(ai);
+            ex.setActivatingPlayer(ai);
+            final Game game = ai.getGame();
+            // 1) in response to a threat to a creature we control that this effect can save
+            if (!game.getStack().isEmpty()) {
+                for (final forge.game.GameObject o : forge.ai.ComputerUtil.predictThreatenedObjects(ai, ex, true)) {
+                    if (o instanceof Card c && c.getController().equals(ai) && c.isCreature() && !c.equals(card) && ex.canTarget(c)) {
+                        return true;
+                    }
+                }
+                return false;
+            }
+            // 2) as a combat trick after blockers are declared
+            final forge.game.combat.Combat combat = game.getCombat();
+            if (combat != null && game.getPhaseHandler().is(PhaseType.COMBAT_DECLARE_BLOCKERS)) {
+                int att = 0;
+                int def = 0;
+                final java.util.List<String> kws = new java.util.ArrayList<>();
+                if (ex.getApi() == ApiType.PutCounter) {
+                    if (!"P1P1".equals(ex.getParam("CounterType"))) {
+                        return false;
+                    }
+                    att = def = forge.game.ability.AbilityUtils.calculateAmount(card, ex.getParamOrDefault("CounterNum", "1"), ex);
+                } else if (ex.getApi() == ApiType.Pump) {
+                    att = ex.hasParam("NumAtt") ? forge.game.ability.AbilityUtils.calculateAmount(card, ex.getParam("NumAtt"), ex) : 0;
+                    def = ex.hasParam("NumDef") ? forge.game.ability.AbilityUtils.calculateAmount(card, ex.getParam("NumDef"), ex) : 0;
+                    if (ex.hasParam("KW")) {
+                        kws.addAll(java.util.Arrays.asList(ex.getParam("KW").split(" & ")));
+                    }
+                } else {
+                    return false;
+                }
+                for (final Card c : ai.getCreaturesInPlay()) {
+                    if ((combat.isAttacking(c) || combat.isBlocking(c)) && ex.canTarget(c)
+                            && forge.ai.ComputerUtilCard.shouldPumpCard(ai, ex, c, def, att, kws)) {
+                        return true;
+                    }
+                }
+            }
+        } catch (final Exception e) {
+            return false;
+        }
+        return false;
+    }
 }
