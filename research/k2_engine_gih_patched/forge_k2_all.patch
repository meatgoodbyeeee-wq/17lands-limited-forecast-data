+
+    // ---- L5b research helpers
+    private static final java.util.Map<String, Integer> L5B_HELD = new java.util.concurrent.ConcurrentHashMap<>();
+
+    protected static boolean l5bIsPlainInstantRemoval(final Player ai, final SpellAbility sa) {
+        if (!sa.isSpell() || sa.getHostCard() == null || !sa.getHostCard().isInstant() || sa.hasParam("AILogic")
+                || !sa.usesTargeting() || isSorcerySpeed(sa, ai)) {
+            return false;
+        }
+        if (!"Creature".equals(sa.getParamOrDefault("ValidTgts", "").split(",")[0].trim())) {
+            return false;
+        }
+        final forge.game.ability.ApiType api = sa.getApi();
+        if (api == forge.game.ability.ApiType.Destroy || api == forge.game.ability.ApiType.DealDamage) {
+            return true;
+        }
+        if (api == forge.game.ability.ApiType.ChangeZone) {
+            return "Exile".equals(sa.getParam("Destination")) && "Battlefield".equals(sa.getParam("Origin"));
+        }
+        if (api == forge.game.ability.ApiType.Pump) {
+            return sa.isCurse() && sa.getParamOrDefault("NumDef", "").startsWith("-");
+        }
+        return false;
+    }
+
+    protected static boolean l5bWindowOpen(final Player ai, final SpellAbility sa) {
+        final forge.game.Game game = ai.getGame();
+        final PhaseHandler ph = game.getPhaseHandler();
+        if (ComputerUtil.aiLifeInDanger(ai, false, 0)) {
+            // in danger: no holding, but on our own turn still wait until the main phase (nothing is gained in upkeep/draw)
+            return !ph.isPlayerTurn(ai) || (!ph.is(PhaseType.UPKEEP) && !ph.is(PhaseType.DRAW));
+        }
+        for (final forge.game.spellability.SpellAbilityStackInstance si : game.getStack()) {
+            if (si.getActivatingPlayer() != null && si.getActivatingPlayer().isOpponentOf(ai)) {
+                AiCardMemory.clearMemorySet(ai, AiCardMemory.MemorySet.HELD_MANA_SOURCES_FOR_ENEMY_DECLBLK);
+                return true; // respond to an opposing spell or ability
+            }
+        }
+        if (!ph.isPlayerTurn(ai)) {
+            // the opponent's combat (from declare attackers) or end step; release the mana held for it
+            final boolean open = ph.is(PhaseType.END_OF_TURN)
+                    || (ph.getPhase().isAfter(PhaseType.COMBAT_BEGIN) && ph.getPhase().isBefore(PhaseType.MAIN2));
+            if (open) {
+                AiCardMemory.clearMemorySet(ai, AiCardMemory.MemorySet.HELD_MANA_SOURCES_FOR_ENEMY_DECLBLK);
+            }
+            return open;
+        }
+        // own turn: hold the first time and keep the mana for the opponent's turn (as Fog effects do);
+        // allowed again once a full opponent turn has passed
+        final String key = System.identityHashCode(game) + ":" + sa.getHostCard().getId();
+        final Integer held = L5B_HELD.putIfAbsent(key, ph.getTurn());
+        if (held != null && ph.getTurn() >= held + 2 && !ph.is(PhaseType.UPKEEP) && !ph.is(PhaseType.DRAW)) {
+            return true;
+        }
+        if (ai.getController().isAI()) {
+            ((PlayerControllerAi) ai.getController()).getAi().reserveManaSources(sa, PhaseType.COMBAT_DECLARE_BLOCKERS, true);
+        }
+        return false;
+    }
 }
