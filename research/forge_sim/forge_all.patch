+    // ---- research fix (S2_PATCH): a harmless, untargeted spell whose chain draws the caster a card is worth casting for
+    // the card alone when nothing better used the mana: sorcery speed in the AI's own main 2, instant speed at the
+    // opponent's end step (before, e.g. Artifist Acumen waited for a combat use and stayed in hand in 70% of games)
+    private static final java.util.EnumSet<forge.game.ability.ApiType> CANTRIP_MAIN = java.util.EnumSet.of(
+            forge.game.ability.ApiType.PumpAll, forge.game.ability.ApiType.ProtectionAll, forge.game.ability.ApiType.AnimateAll,
+            forge.game.ability.ApiType.UntapAll, forge.game.ability.ApiType.Pump, forge.game.ability.ApiType.Protection);
+
+    protected static boolean isCantripFallback(final Player ai, final SpellAbility sa) {
+        if (!sa.isSpell() || sa.isCurse() || sa.usesTargeting() || !CANTRIP_MAIN.contains(sa.getApi())) {
+            return false;
+        }
+        boolean draws = false;
+        for (AbilitySub sub = sa.getSubAbility(); sub != null; sub = sub.getSubAbility()) {
+            if (sub.getApi() == forge.game.ability.ApiType.Draw && "You".equals(sub.getParamOrDefault("Defined", "You"))
+                    && !sub.usesTargeting()) {
+                draws = true;
+            }
+        }
+        if (!draws) {
+            return false;
+        }
+        final PhaseHandler ph = ai.getGame().getPhaseHandler();
+        return isSorcerySpeed(sa, ai) ? ph.is(PhaseType.MAIN2, ai) && ai.getGame().getStack().isEmpty()
+                : ResearchFixes.isOppEndStep(ai);
+    }
+
+    // ---- L5b research helpers
+    private static final java.util.Map<String, Integer> L5B_HELD = new java.util.concurrent.ConcurrentHashMap<>();
+
+    protected static boolean l5bIsPlainInstantRemoval(final Player ai, final SpellAbility sa) {
+        if (!sa.isSpell() || sa.getHostCard() == null || !sa.getHostCard().isInstant() || sa.hasParam("AILogic")
+                || !sa.usesTargeting() || isSorcerySpeed(sa, ai)) {
+            return false;
+        }
+        if (!"Creature".equals(sa.getParamOrDefault("ValidTgts", "").split(",")[0].trim())) {
+            return false;
+        }
+        final forge.game.ability.ApiType api = sa.getApi();
+        if (api == forge.game.ability.ApiType.Destroy || api == forge.game.ability.ApiType.DealDamage) {
+            return true;
+        }
+        if (api == forge.game.ability.ApiType.ChangeZone) {
+            return "Exile".equals(sa.getParam("Destination")) && "Battlefield".equals(sa.getParam("Origin"));
+        }
+        if (api == forge.game.ability.ApiType.Pump) {
