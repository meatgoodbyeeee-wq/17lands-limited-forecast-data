+    // research fix on top of L4 (FORGE_SIM fixes): hold a protective flash creature for at most one opponent turn; after that
+    // cast it as before from the next own main phase (L4 held body-value creatures like Plumecreed Escort for too long)
+    private static final java.util.Map<String, Integer> L4_HELD = new java.util.concurrent.ConcurrentHashMap<>();
+
+    private static boolean l4HoldExpired(final Card card, final Player ai, final PhaseHandler ph) {
