+++ b/forge-ai/src/main/java/forge/ai/ability/CountersPutAllAi.java
@@ -115,6 +115,15 @@ public class CountersPutAllAi extends SpellAbilityAi {
 
     @Override
     public AiAbilityDecision chkDrawback(Player ai, SpellAbility sa) {
+        // research fix: as a rider of a spell, a beneficial counter sweep only has to not help the opponent more
+        // (before, no valid cards on either side refused the whole spell, e.g. Command the Stage)
+        if (!sa.isCurse() && !sa.usesTargeting()) {
+            final Card source = sa.getHostCard();
+            final String valid = sa.getParam("ValidCards");
+            int opp = CardLists.getValidCards(ai.getWeakestOpponent().getCardsIn(ZoneType.Battlefield), valid, ai, source, sa).size();
+            int own = CardLists.getValidCards(ai.getCardsIn(ZoneType.Battlefield), valid, ai, source, sa).size();
+            return opp > own ? new AiAbilityDecision(0, AiPlayDecision.CantPlayAi) : new AiAbilityDecision(100, AiPlayDecision.WillPlay);
+        }
         return canPlay(ai, sa);
     }
