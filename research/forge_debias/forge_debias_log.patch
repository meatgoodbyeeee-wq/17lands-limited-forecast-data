@@ -208,9 +208,13 @@ public final class AITimeoutTracker {
     }
 
     /** Cheap: call it inside AI loops. Throws {@link Expired} once the armed deadline passed (no-op when not armed). */
+    /** Research counter (forge-debias, observation only): AI decisions cut short by the deadline in this JVM. */
+    public static final java.util.concurrent.atomic.AtomicInteger EXPIRED_COUNT = new java.util.concurrent.atomic.AtomicInteger();
+
     public static void check() {
         final Limit l = LIMIT.get();
         if (l.armed && (System.nanoTime() - l.deadlineNanos >= 0 || (l.honourInterrupt && Thread.currentThread().isInterrupted()))) {
+            EXPIRED_COUNT.incrementAndGet();
             throw new Expired();
         }
     }
